{
    "name": "lprin/books-list-exercise",
    "description": "Exercice technique Attineos — plugin WordPress d'affichage de livres issus de l'API Gutendex.",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.10",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpunit/phpunit": "^10.5"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "test": "phpunit"
    },
    "scripts-descriptions": {
        "lint": "Analyse le plugin avec les WordPress Coding Standards.",
        "lint:fix": "Corrige automatiquement ce qui peut l'être.",
        "test": "Exécute les tests unitaires."
    }
}

# Normalisation des fins de ligne.
#
# Le dépôt est développé sous Windows mais exécuté dans des conteneurs Linux.
# Sans ces règles, un script shell commité en CRLF échoue dans le conteneur
# avec l'erreur « bad interpreter: no such file or directory ».

* text=auto eol=lf

*.sh      text eol=lf
*.php     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.json    text eol=lf
*.xml     text eol=lf
*.md      text eol=lf
*.css     text eol=lf
*.js      text eol=lf
*.pot     text eol=lf
Makefile  text eol=lf

*.bat     text eol=crlf
*.ps1     text eol=crlf

*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.mo   binary
*.zip  binary
